[Unit]
Description=llama-swap dynamic local model proxy (llama.cpp)
ConditionPathExists=%h/.config/llama-swap/config.yaml

[Service]
Type=simple
ExecStart=/usr/bin/llama-swap --config %h/.config/llama-swap/config.yaml --listen 127.0.0.1:8080
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
