{
    "$schema": "https://opencode.ai/config.json",
    "websearch": false,
    "default_agent": "orchestrator",
    "providers": {
        "local": {
            "name": "llama-swap local GPU",
            "package": "@opencode/ai/providers/openai-compatible",
            "settings": {
                "baseURL": "http://127.0.0.1:8080/v1"
            },
            "models": {
                "qwen-27b": {
                    "modelID": "qwen-27b",
                    "name": "Qwen3.8 27B UD-IQ3_XXS",
                    "capabilities": {
                        "tools": true,
                        "input": ["text"],
                        "output": ["text"],
                        "temperature": true,
                        "reasoning": { "supported": false }
                    },
                    // Served with --reasoning off; the template's default is
                    // xhigh thinking, which is far too slow on a 27B IQ3.
                    "limit": { "context": 65536, "output": 8192 },
                    "body": {
                        "temperature": 0.7,
                        "top_p": 0.8,
                        "top_k": 20,
                        "min_p": 0.0
                    }
                },
                "qwen-27b-think": {
                    "modelID": "qwen-27b-think",
                    "name": "Qwen3.8 27B UD-IQ3_XXS (thinking)",
                    "capabilities": {
                        "tools": true,
                        "input": ["text"],
                        "output": ["text"],
                        "temperature": true,
                        "reasoning": { "supported": true }
                    },
                    // Same GGUF as qwen-27b, served with --reasoning on and
                    // high effort (template maps high -> xhigh). Sampling follows
                    // Qwen's thinking-mode recommendation. Thinking shares the
                    // output budget, so long xhigh runs can hit the 8192 cap.
                    "limit": { "context": 65536, "output": 8192 },
                    "body": {
                        "temperature": 0.6,
                        "top_p": 0.95,
                        "top_k": 20,
                        "min_p": 0.0
                    }
                },
                "qwen-heretic-8b": {
                    "modelID": "qwen-heretic-8b",
                    "name": "Qwen3 8B Heretic",
                    "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
                    "limit": { "context": 32768, "output": 8192 }
                }
            }
        }
    },
    "mcp": {
        "k8s": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@dockndevai/mcp-kubernetes"
            ],
            "environment": {
                "KUBECONFIG_PATH": "{file:~/.secrets/kubeconfig}",
                "K8S_MODE": "read-only"
            },
            "enabled": true
        },
        // searxng lives in the v2 "servers" map on purpose: that is the only
        // place a "codemode" flag survives config normalization (legacy
        // top-level entries are re-encoded and silently drop unknown keys).
        // codemode:false registers the server's tools natively instead of
        // routing them through the `execute` tool, so agents that deny
        // `execute` (e.g. explorer) still get them in their tool catalog.
        "servers": {
            "searxng": {
                "type": "local",
                "command": [
                    "npx",
                    "-y",
                    "mcp-searxng@2.7.0"
                ],
                "environment": {
                    // Basic-auth URL read from an untracked file OUTSIDE this repo (chmod 600, no trailing newline).
                    // {file:} works regardless of how opencode is launched — no shell env inheritance needed.
                    "SEARXNG_URL": "{file:~/.secrets/searxng-url}"
                },
                "codemode": false
            }
        }
    }
}
