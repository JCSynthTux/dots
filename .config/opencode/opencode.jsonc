{
    "$schema": "https://opencode.ai/config.json",
    "websearch": false,
    "plugin": [
        "@knikolov/opencode-plugin-simple-memory"
    ],
    "default_agent": "orchestrator",
    "mcp": {
        "rea": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "rea-agents@6.5.0",
                "mcp"
            ],
            "enabled": true
        },
        "k8s": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@dockndevai/mcp-kubernetes"
            ],
            "environment": {
                "KUBECONFIG_PATH": "{env:KUBECONFIG_PATH}",
                "K8S_MODE": "read-only"
            },
            "enabled": true
        },
        "searxng": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "mcp-searxng"
            ],
            "environment": {
                // SEARXNG_URL must include basic-auth userinfo: https://agent:<password>@search.thetomie.com
                // Unset resolves to an empty string and searxng searches fail. NEVER commit the value to
                // this repo (.zshrc is tracked here too). Use ~/.config/environment.d/90-searxng.conf for
                // GNOME/session launches, or a secret manager / untracked file sourced from ~/.zshrc.
                "SEARXNG_URL": "{env:SEARXNG_URL}"
            },
            "enabled": true
        }
    }
}
