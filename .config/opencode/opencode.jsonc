{
    "$schema": "https://opencode.ai/config.json",
    "plugin": [
        "@dietrichgebert/ponytail",
        "@knikolov/opencode-plugin-simple-memory"
    ],
    "default_agent": "orchestrator",
    "mcp": {
        "rea": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "rea-agents@6.5.0",
                "mcp"
            ],
            "enabled": true
        },
        "k8s": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@dockndevai/mcp-kubernetes"
            ],
            "environment": {
                "KUBECONFIG_PATH": "$HOME/.kube/config",
                "K8S_MODE": "read-only"
            },
            "enabled": true
        }
    }
}
