{
    "$schema": "https://opencode.ai/config.json",
    "websearch": false,
    "default_agent": "orchestrator",
    "mcp": {
        "servers": {
            "k8s": {
                "type": "local",
                "command": [
                    "npx",
                    "-y",
                    "@dockndevai/mcp-kubernetes@0.4.1"
                ],
                "environment": {
                    "KUBECONFIG_PATH": "{env:KUBECONFIG}",
                    "K8S_MODE": "read-only",
                    "NODE_EXTRA_CA_CERTS": "/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem"
                },
                "disabled": false
            },
            "searxng": {
                "type": "local",
                "command": [
                    "npx",
                    "-y",
                    "mcp-searxng@2.7.0"
                ],
                "environment": {
                    // Basic-auth URL read from an untracked file OUTSIDE this repo (chmod 600, no trailing newline).
                    // {file:} works regardless of how opencode is launched — no shell env inheritance needed.
                    "SEARXNG_URL": "{file:~/.secrets/searxng-url}",
                    // See the k8s entry: node needs the system trust bundle.
                    "NODE_EXTRA_CA_CERTS": "/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem"
                },
                "codemode": false
            },
            "gitea-mcp": {
                "enabled": true,
                "type": "local",
                "command": [
                    "gitea-mcp-server",
                    "-t",
                    "stdio"
                ],
                "environment": {
                    "GITEA_ACCESS_TOKEN": "{file:~/.secrets/gitea_token}",
                    "GITEA_HOST": "{file:~/.secrets/gitea_host}",
                    "NODE_EXTRA_CA_CERTS": "/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem"
                },
                "disabled": false
            }
        }
    }
}
