{
    "$schema": "https://opencode.ai/config.json",
    "websearch": false,
    "plugin": [
        "@knikolov/opencode-plugin-simple-memory"
    ],
    "default_agent": "orchestrator",
    "mcp": {
        "rea": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "rea-agents@6.5.0",
                "mcp"
            ],
            "enabled": true
        },
        "k8s": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@dockndevai/mcp-kubernetes"
            ],
            "environment": {
                "KUBECONFIG_PATH": "$HOME/.kube/config",
                "K8S_MODE": "read-only"
            },
            "enabled": true
        },
        "searxng": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "mcp-searxng"
            ],
            "environment": {
                // Basic-auth URL read from an untracked file OUTSIDE this repo (chmod 600, no trailing newline).
                // {file:} works regardless of how opencode is launched — no shell env inheritance needed.
                "SEARXNG_URL": "{file:~/.secrets/searxng-url}"
            },
            "enabled": true
        }
    }
}
